rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =====================================================
    // SUPPORT TICKETS
    // =====================================================

    match /supportTickets/{ticketId} {

      // Authenticated users can create their own tickets.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // Customers can read only their own tickets.
      // Admins and Super Admins can read all tickets.
      allow read: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // Customers cannot modify tickets after creation.
      // Admins and Super Admins can manage any ticket.
      allow update: if request.auth != null
        && isAdmin();

      // Tickets should normally never be deleted by customers.
      // Admins can delete if necessary.
      allow delete: if request.auth != null
        && isAdmin();

      // -----------------------------------------------------
      // SUPPORT TICKET MESSAGES
      // -----------------------------------------------------

      match /messages/{messageId} {

        // Ticket owner and admins can read messages.
        allow read: if request.auth != null
          && (
            get(/databases/$(database)/documents/supportTickets/$(ticketId))
              .data.userId == request.auth.uid
            || isAdmin()
          );

        // Customers can create only their own CUSTOMER messages.
        // Admins can create staff messages.
        allow create: if request.auth != null
          && (
            (
              get(/databases/$(database)/documents/supportTickets/$(ticketId))
                .data.userId == request.auth.uid
              && request.resource.data.senderId == request.auth.uid
              && request.resource.data.senderRole == "CUSTOMER"
            )
            || isAdmin()
          );

        // Messages should not be modified by customers.
        allow update: if request.auth != null
          && isAdmin();

        allow delete: if request.auth != null
          && isAdmin();
      }
    }


    // =====================================================
    // ADMIN CHECK
    // =====================================================

    function isAdmin() {

      return request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && (
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == "ADMIN"

          || get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == "SUPER_ADMIN"
        );
    }


    // =====================================================
    // TEMPORARY FALLBACK
    // =====================================================
    //
    // Existing application collections are not changed by
    // this Step 26 support rule file yet.
    //
    // We will inspect and secure those collections separately
    // rather than accidentally breaking existing functionality.
    //


      // =====================================================
      // DELIVERIES
      // =====================================================

      match /deliveries/{deliveryId} {

        // Admins and Super Admins can manage deliveries.
        allow read, update, delete: if isAdmin();

        // Customers can create only their own new, unassigned,
        // payment-pending delivery.
        allow create: if request.auth != null
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.partnerId == null
          && request.resource.data.status == "PAYMENT_PENDING"
          && request.resource.data.paymentStatus == "PAYMENT_PENDING";

        // Customers can read only their own deliveries.
        allow read: if request.auth != null
          && request.auth.uid == resource.data.customerId;

        // Assigned partners can read only deliveries assigned to them.
        allow read: if request.auth != null
          && request.auth.uid == resource.data.partnerId;

        // Sensitive delivery updates must go through trusted
        // backend functions.
        allow update, delete: if false;
      }


      // =====================================================
      // RIDE BOOKINGS
      // =====================================================

      match /rideBookings/{bookingId} {

        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid;

        allow read: if request.auth != null
          && (
            resource.data.userId == request.auth.uid
            || isAdmin()
          );

        allow update: if request.auth != null
          && isAdmin();

        allow delete: if request.auth != null
          && isAdmin();
      }


      // USER PROFILES
      match /users/{userId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;

        allow write: if false;
      }

  }
}
