rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =====================================================
    // SUPPORT TICKETS
    // =====================================================

    match /supportTickets/{ticketId} {

      // Authenticated users can create their own tickets.
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      // Customers can read only their own tickets.
      // Admins and Super Admins can read all tickets.
      allow read: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );

      // Customers cannot modify tickets after creation.
      // Admins and Super Admins can manage any ticket.
      allow update: if request.auth != null
        && isAdmin();

      // Tickets should normally never be deleted by customers.
      // Admins can delete if necessary.
      allow delete: if request.auth != null
        && isAdmin();

      // -----------------------------------------------------
      // SUPPORT TICKET MESSAGES
      // -----------------------------------------------------

      match /messages/{messageId} {

        // Ticket owner and admins can read messages.
        allow read: if request.auth != null
          && (
            get(/databases/$(database)/documents/supportTickets/$(ticketId))
              .data.userId == request.auth.uid
            || isAdmin()
          );

        // Customers can create only their own CUSTOMER messages.
        // Admins can create staff messages.
        allow create: if request.auth != null
          && (
            (
              get(/databases/$(database)/documents/supportTickets/$(ticketId))
                .data.userId == request.auth.uid
              && request.resource.data.senderId == request.auth.uid
              && request.resource.data.senderRole == "CUSTOMER"
            )
            || isAdmin()
          );

        // Messages should not be modified by customers.
        allow update: if request.auth != null
          && isAdmin();

        allow delete: if request.auth != null
          && isAdmin();
      }
    }


    // =====================================================
    // ADMIN CHECK
    // =====================================================

    function isAdmin() {

      return request.auth != null
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && (
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == "ADMIN"

          || get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == "SUPER_ADMIN"
        );
    }


    // =====================================================
    // TEMPORARY FALLBACK
    // =====================================================
    //
    // Existing application collections are not changed by
    // this Step 26 support rule file yet.
    //
    // We will inspect and secure those collections separately
    // rather than accidentally breaking existing functionality.
    //


        // =====================================================
        // CUSTOMER DELIVERY PRICING
        // =====================================================

        match /settings/pricing {
          // Private Admin/platform pricing configuration.
          allow read, write: if isAdmin();
        }

        match /settings/deliveryPricing {
          // Customers need only the rates required to calculate
          // their delivery quote.
          allow read: if request.auth != null;

          // Only Admins and Super Admins may change these rates.
          allow write: if isAdmin();
        }

      // =====================================================
      // DELIVERIES
      // =====================================================

      match /deliveries/{deliveryId} {

        // Admins and Super Admins can manage deliveries.
        allow read, update, delete: if isAdmin();

        // Customers can create only their own new, unassigned,
        // payment-pending delivery.
        allow create: if request.auth != null
          && request.resource.data.customerId == request.auth.uid
          && request.resource.data.partnerId == null
          && request.resource.data.status == "PAYMENT_PENDING"
          && request.resource.data.paymentStatus == "PAYMENT_PENDING";

        // Customers can read only their own deliveries.
        allow read: if request.auth != null
          && request.auth.uid == resource.data.customerId;

        // Assigned partners can read only deliveries assigned to them.
        allow read: if request.auth != null
          && request.auth.uid == resource.data.partnerId;

        // Sensitive delivery updates must go through trusted
        // backend functions.
        allow update, delete: if false;
      }


      // =====================================================
      // LEGACY RIDES
      // =====================================================

      match /rides/{rideId} {

        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.resource.data.createdBy == request.auth.uid;

        allow update, delete: if request.auth != null
          && isAdmin();
      }


      // =====================================================
      // RIDE BOOKINGS
      // =====================================================

      match /rideBookings/{bookingId} {

        // Customers may only read their own ride bookings.
        allow read: if request.auth != null
          && (
            resource.data.userId == request.auth.uid
            || isAdmin()
          );

        // Ride bookings are created and changed only by
        // trusted Cloud Functions or Admin operations.
        allow create, update, delete: if isAdmin();
      }

      // =====================================================
      // RIDE SEAT HOLDS
      // =====================================================

      match /rideSeatHolds/{holdId} {

        // Seat holds are fully server-controlled.
        // Cloud Functions use the Admin SDK and bypass rules.
        allow read, create, update, delete: if false;
      }


      // =====================================================
      // RIDE TRIPS
      // =====================================================

      match /trips/{tripId} {

        // Signed-in customers and admins can view trips.
        allow read: if request.auth != null;

        // Only Admins and Super Admins may create trips.
        allow create: if request.auth != null
          && isAdmin()
          && request.resource.data.createdBy == request.auth.uid;

        // Only Admins and Super Admins may update trips.
        allow update: if request.auth != null
          && isAdmin();

        // Only Admins and Super Admins may delete trips.
        allow delete: if request.auth != null
          && isAdmin();
      }


      // =====================================================
      // ADMIN VENDORS
      // =====================================================

      match /vendors/{vendorId} {
        allow read, create, update, delete: if isAdmin();
      }


      // =====================================================
      // ADMIN WITHDRAWALS
      // =====================================================

      match /withdrawals/{withdrawalId} {
        allow read, create, update, delete: if isAdmin();
      }


      // =====================================================
      // ADMIN AUDIT LOGS
      // =====================================================

      match /auditLogs/{auditLogId} {
        allow read, create, update, delete: if isAdmin();
      }


      // =====================================================
      // ADMIN WALLET TRANSACTIONS
      // =====================================================

      match /walletTransactions/{transactionId} {
        allow read, create, update, delete: if isAdmin();
      }


      // =====================================================
      // ADMIN EXPENSES
      // =====================================================

      match /expenses/{expenseId} {
        allow read, create, update, delete: if isAdmin();
      }


      // USER PROFILES
      match /users/{userId} {
        // Users can read only their own profile.
        allow read: if request.auth != null
          && (
            request.auth.uid == userId
            || isAdmin()
          );

        // A newly authenticated user may create only their own profile.
        // Existing profiles cannot be overwritten from the client.
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.uid == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid == userId;

        allow delete: if false;
      }

      // USER WALLETS
      match /wallets/{userId} {
        // Users may read only their own wallet.
        allow read: if request.auth != null
          && request.auth.uid == userId;

        // Registration may create the user's initial wallet.
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;

        // Wallet balances must not be changed directly by clients.
        allow update, delete: if false;
      }

      // REFERRALS
      match /referrals/{referralId} {
        // A signed-in user may create a referral record for themselves.
        allow create: if request.auth != null
          && request.resource.data.referredUserId == request.auth.uid;

        allow read: if request.auth != null
          && (
            resource.data.referredUserId == request.auth.uid
            || isAdmin()
          );

        allow update, delete: if isAdmin();
      }

  }
}
