{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "dreypella-ride-4",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/functions/**",
      "**/*.bak",
      "**/*.backup",
      "**/*.before-*",
      "**/*.work",
      "**/firebase-debug.log",
      "**/firestore-debug.log",
      "**/checkout-test.js",
      "**/support-step26-status.txt",
      "**/| sed*"
    ]
  }
}
